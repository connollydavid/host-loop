# host-loop obligations (plan/0109, the slot model). Invoke with:
#   host-lifecycle obligations host-loop.allium --tests . --strict-discharge
# The test dispositions name the tier-1 suite; every shipped test exercises its
# token.

entity-fields.GoalSurface     => structural
entity-fields.NativeGoal      => structural
surface-actor.HostLoop        => structural
surface-provides.HostLoop     => structural

rule-success.SetArmsBoth          => test:set_drives_the_verb_then_arms_the_native_goal exercises=the verb ran first
rule-success.ParkPausesBoth       => test:park_pauses_the_native_goal exercises=the native goal was paused
rule-success.UnparkResumesBoth    => test:unpark_resumes_a_paused_native_goal exercises=the native goal was resumed
rule-success.UnparkRearmsAfterClear => test:unpark_rearms_when_no_native_goal_exists exercises=a fresh native goal was created
rule-success.CompleteClearsNative => test:complete_banks_then_clears_the_native_goal exercises=a banked closure clears the native goal
rule-success.AcceptClosesHost     => test:accept_closes_the_host_goal exercises=the accept verb ran
rule-success.BeltPausesNative     => test:the_cap_belt_pauses_at_the_round_limit exercises=the round cap

rule-failure.SetArmsBoth.1          => test:a_refused_set_arms_nothing exercises=a refused set arms nothing
rule-failure.ParkPausesBoth.1       => test:park_pauses_even_without_a_native_goal exercises=the pause was issued
rule-failure.UnparkResumesBoth.1    => test:a_refusing_unpark_runs_no_native_command exercises=no native resume
rule-failure.UnparkRearmsAfterClear.1 => test:a_refusing_unpark_runs_no_native_command exercises=no native rearm
rule-failure.CompleteClearsNative.1 => test:complete_banks_then_clears_the_native_goal exercises=a refused gate clears nothing
rule-failure.AcceptClosesHost.1     => test:a_refused_accept_drives_no_closure exercises=the refusal reached the session
rule-failure.BeltPausesNative.1     => test:the_belts_hold_fire_on_a_paused_goal exercises=already stopped
